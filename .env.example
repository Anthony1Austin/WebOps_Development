# Resend (existing)
RESEND_API_KEY=

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# Site key is public (exposed to the browser via /api/site-config).
TURNSTILE_SITE_KEY=
# Secret key — server-only; required for /api/contact
TURNSTILE_SECRET_KEY=

# Optional: Upstash Redis for rate limiting (5 submissions / 15 min per IP)
# https://console.upstash.com/ — free tier is enough for typical contact volume
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare test keys (always pass) for local dev:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
